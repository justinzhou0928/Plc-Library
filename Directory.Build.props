<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ExtensionsVersion>8.0.0</ExtensionsVersion>
    <ExtensionsVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.9</ExtensionsVersion>
    <Nullable>enable</Nullable>
    <Version>2.1.0</Version>
    <GenerateDocumentationFile Condition="'$(MSBuildProjectName)' != 'PlcLibrary.Tests'">true</GenerateDocumentationFile>
    <Authors>JustiionZhou</Authors>
    <Description>工业 PLC 数据采集基础库，支持 Modbus/S7/OPC UA/三菱/欧姆龙/Allen-Bradley/BACnet，含连接池、重试熔断、数据管道。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/justinzhou0928/Plc-Library</PackageProjectUrl>
    <RepositoryUrl>https://github.com/justinzhou0928/Plc-Library.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
  </ItemGroup>
</Project>
